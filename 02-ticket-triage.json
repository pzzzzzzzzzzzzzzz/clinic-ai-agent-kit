        "jsonBody": "={{ JSON.stringify($json) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "a2000000-0000-4000-8000-000000000006",
      "name": "Call model",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        840,
        320
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "e2000000-0000-4000-8000-000000000001",
          "name": "OpenAI API Key"
        }
      }
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Never throws. Category is normalised to exactly one of: urgent | normal | spam.\nconst orig = $('Parse input').first().json;\nconst out = [];\n\nfor (const item of $input.all()) {\n  const src = item.json;\n  const body = (src && src.body !== undefined && src.body !== null) ? src.body : src;\n\n  let text = '';\n  if (body && typeof body === 'object' && Array.isArray(body.choices) && body.choices[0]) {\n    text = body.choices[0].message?.content ?? '';\n  } else if (typeof body === 'string') {\n    text = body;\n  } else if (body && typeof body.content === 'string') {\n    text = body.content;\n  }\n\n  let parsed = null;\n  let parseError = '';\n  try {\n    const t = String(text || '').trim();\n    if (!t) throw new Error('empty model response');\n    parsed = JSON.parse(t);\n    if (!parsed || typeof parsed !== 'object') throw new Error('response was not an object');\n  } catch (e) {\n    parsed = null;\n    parseError = (e && e.message) ? e.message : String(e);\n  }\n\n  if (!parsed) {\n    out.push({\n      json: {\n        id: orig.id, subject: orig.subject, from: orig.from,\n        category: 'normal', reason: 'Could not read a JSON triage result from the model. Check the API key and endpoint in Config.',\n        needs_human: true, draft_reply: '', suggested_tags: [],\n        status: 'error', error: parseError, raw_excerpt: String(text || '').slice(0, 300)\n      }\n    });\n    continue;\n  }\n\n  let category = String(parsed.category ?? '').toLowerCase().trim();\n  if (!['urgent', 'normal', 'spam'].includes(category)) category = 'normal';\n\n  out.push({\n    json: {\n      id: orig.id, subject: orig.subject, from: orig.from, receivedAt: orig.receivedAt,\n      category,\n      reason: parsed.reason ?? '',\n      needs_human: category === 'urgent' ? true : Boolean(parsed.needs_human),\n      draft_reply: String(parsed.draft_reply ?? '').slice(0, 800),\n      suggested_tags: Array.isArray(parsed.suggested_tags) ? parsed.suggested_tags.slice(0, 3) : [],\n      status: 'triaged'\n    }\n  });\n}\n\nreturn out;\n"
      },
