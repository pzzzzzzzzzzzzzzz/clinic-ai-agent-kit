    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// ============================================================\n// PROMPT (edit me) — change the rules and the wording here.\n// Nothing below this line needs to change when you edit this.\n// ============================================================\nconst systemPrompt = `You are a patient communication triage engine for a clinic.\nClassify the incoming message and draft a reply. Never invent clinical facts and never give\nmedical advice — if it needs a clinician or the practice manager, say so.\n\nReturn STRICT JSON:\n{\n  \"category\": \"urgent\" | \"normal\" | \"spam\",\n  \"reason\": \"<one sentence>\",\n  \"needs_human\": <true|false>,\n  \"draft_reply\": \"<reply text, max 120 words>\",\n  \"suggested_tags\": [<up to 3 tags>]\n}\n\nRules for \"urgent\": pain or any emergency, allergic reaction, infection, medication reaction,\nbleeding, a post-procedure complication, an injury, a billing or insurance dispute, a complaint\nthat could reach the practice manager, or anything that could harm a patient.\nNever give medical advice in the draft reply — for anything clinical, ask the patient to\ncontact the clinic and offer a callback.`;\n\nconst userTemplate = `Triage this patient message for {{bizName}}.\n\nPATIENT: {{from}}\nRECEIVED: {{receivedAt}}\nSUBJECT: {{subject}}\nMESSAGE:\n{{body}}\n\nReturn JSON only.`;\n\nreturn [{ json: { systemPrompt, userTemplate } }];\n"
      },
      "id": "a2000000-0000-4000-8000-000000000004",
      "name": "Prompt (edit me)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        320
      ]
    },
    {
      "parameters": {
        "mode": "runOnceForAllItems",
        "jsCode": "// Builds the API request. Contains NO prompt text and NO thresholds.\nconst config = $('Config (edit me)').first().json;\nconst prompt = $('Prompt (edit me)').first().json;\n\nconst out = [];\nfor (const item of $input.all()) {\n  const src = item.json;\n  const userContent = prompt.userTemplate\n    .replace('{{bizName}}', config.bizName || 'the business')\n    .replace('{{from}}', src.from || '')\n    .replace('{{receivedAt}}', src.receivedAt || '')\n    .replace('{{subject}}', src.subject || '')\n    .replace('{{body}}', src.body || '');\n\n  const body = {\n    model: config.model,\n    temperature: 0,\n    messages: [\n      { role: 'system', content: prompt.systemPrompt },\n      { role: 'user', content: userContent }\n    ]\n  };\n  if (config.useJsonMode !== false) {\n    body.response_format = { type: 'json_object' };\n  }\n\n  out.push({ json: body });\n}\n\nreturn out;\n"
      },
      "id": "a2000000-0000-4000-8000-000000000005",
      "name": "Build request",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        620,
        320
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "={{ $('Config (edit me)').first().json.baseUrl }}",
        "sendBody": true,
